<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://exemplo.org/turismo.owl"
         xmlns="http://exemplo.org/turismo.owl#">

<owl:Ontology rdf:about="http://exemplo.org/turismo.owl"/>

<owl:ObjectProperty rdf:about="#temAtracao">
  <rdfs:domain rdf:resource="#Destino"/>
  <rdfs:range rdf:resource="#Atracao"/>
  <owl:inverseOf rdf:resource="#atracaoDe"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atracaoDe">
  <owl:inverseOf rdf:resource="#temAtracao"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#localizadoEm">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Lugar"/>
  <rdfs:range rdf:resource="#Lugar"/>
  <owl:inverseOf rdf:resource="#contem"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contem">
  <owl:inverseOf rdf:resource="#localizadoEm"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temClima">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Destino"/>
  <rdfs:range rdf:resource="#Clima"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atendeInteresse">
  <rdfs:domain rdf:resource="#Atracao"/>
  <rdfs:range rdf:resource="#Interesse"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ofereceInteresse">
  <rdfs:domain rdf:resource="#Destino"/>
  <rdfs:range rdf:resource="#Interesse"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#temAtracao"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#atendeInteresse"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#proximoDe">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Destino"/>
  <rdfs:range rdf:resource="#Destino"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temInteresse">
  <rdfs:domain rdf:resource="#Viajante"/>
  <rdfs:range rdf:resource="#Interesse"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefereClima">
  <rdfs:domain rdf:resource="#Viajante"/>
  <rdfs:range rdf:resource="#Clima"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#jaVisitou">
  <rdfs:domain rdf:resource="#Viajante"/>
  <rdfs:range rdf:resource="#Destino"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#custoDiario">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Destino"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#avaliacao">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Destino"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#diasSugeridos">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Destino"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#orcamentoDiario">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Viajante"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#diasDisponiveis">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Viajante"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nome">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Lugar">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Destino">
  <rdfs:subClassOf rdf:resource="#Lugar"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temClima"/>
      <owl:onClass rdf:resource="#Clima"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#localizadoEm"/>
      <owl:someValuesFrom rdf:resource="#Estado"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Estado">
  <rdfs:subClassOf rdf:resource="#Lugar"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#localizadoEm"/>
      <owl:someValuesFrom rdf:resource="#Regiao"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Regiao">
  <rdfs:subClassOf rdf:resource="#Lugar"/>
</owl:Class>

<owl:Class rdf:about="#Atracao">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AtracaoNatural">
  <rdfs:subClassOf rdf:resource="#Atracao"/>
  <owl:disjointWith rdf:resource="#AtracaoCultural"/>
</owl:Class>

<owl:Class rdf:about="#AtracaoCultural">
  <rdfs:subClassOf rdf:resource="#Atracao"/>
</owl:Class>

<owl:Class rdf:about="#Praia">
  <rdfs:subClassOf rdf:resource="#AtracaoNatural"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atendeInteresse"/>
      <owl:hasValue rdf:resource="#praia"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atendeInteresse"/>
      <owl:hasValue rdf:resource="#natureza"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Cachoeira">
  <rdfs:subClassOf rdf:resource="#AtracaoNatural"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atendeInteresse"/>
      <owl:hasValue rdf:resource="#aventura"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atendeInteresse"/>
      <owl:hasValue rdf:resource="#natureza"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Trilha">
  <rdfs:subClassOf rdf:resource="#AtracaoNatural"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atendeInteresse"/>
      <owl:hasValue rdf:resource="#aventura"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atendeInteresse"/>
      <owl:hasValue rdf:resource="#natureza"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Museu">
  <rdfs:subClassOf rdf:resource="#AtracaoCultural"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atendeInteresse"/>
      <owl:hasValue rdf:resource="#cultura"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#CentroHistorico">
  <rdfs:subClassOf rdf:resource="#AtracaoCultural"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atendeInteresse"/>
      <owl:hasValue rdf:resource="#historia"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atendeInteresse"/>
      <owl:hasValue rdf:resource="#cultura"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Interesse">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Clima">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Viajante">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#DestinoDePraia">
  <rdfs:subClassOf rdf:resource="#Destino"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Destino"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temAtracao"/>
          <owl:someValuesFrom rdf:resource="#Praia"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#DestinoCultural">
  <rdfs:subClassOf rdf:resource="#Destino"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Destino"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temAtracao"/>
          <owl:someValuesFrom rdf:resource="#AtracaoCultural"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#DestinoDeNatureza">
  <rdfs:subClassOf rdf:resource="#Destino"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Destino"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temAtracao"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#Cachoeira"/>
                <rdf:Description rdf:about="#Trilha"/>
              </owl:unionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#DestinoCompleto">
  <rdfs:subClassOf rdf:resource="#Destino"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Destino"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temAtracao"/>
          <owl:someValuesFrom rdf:resource="#AtracaoNatural"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temAtracao"/>
          <owl:someValuesFrom rdf:resource="#AtracaoCultural"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#DestinoEconomico">
  <rdfs:subClassOf rdf:resource="#Destino"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Destino"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#custoDiario"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">300</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ViajanteEconomico">
  <rdfs:subClassOf rdf:resource="#Viajante"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Viajante"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#orcamentoDiario"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">300</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

