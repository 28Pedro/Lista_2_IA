<owl:NamedIndividual rdf:about="#Maragogi">
  <rdf:type rdf:resource="#Destino"/>
  <temClima rdf:resource="#quente"/>
  <localizadoEm rdf:resource="#AL"/>
  <temAtracao rdf:resource="#Piscinas_Naturais_de_Maragogi"/>
  <proximoDe rdf:resource="#Porto_de_Galinhas"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maragogi</nome>
  <custoDiario rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">380</custoDiario>
  <avaliacao rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.7</avaliacao>
  <diasSugeridos rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</diasSugeridos>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Piscinas_Naturais_de_Maragogi">
